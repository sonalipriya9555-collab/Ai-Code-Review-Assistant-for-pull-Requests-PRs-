# Port the Express server will listen on
PORT=5000

# Allowed origin for CORS (the URL your frontend is served from)
CORS_ORIGIN=http://localhost:3000

# Maximum allowed size (in characters) for submitted code, used by validators.js
MAX_CODE_LENGTH=20000

# ---------------------------------------------------------------------------
# FUTURE AI PROVIDER INTEGRATION (not required for the mock/local reviewer)
# ---------------------------------------------------------------------------
# Uncomment and fill these in when you plug in a real AI provider inside
# services/codeReviewService.js. Never commit real keys to source control,
# and never expose them to the frontend.
#
# AI_PROVIDER=openai
# AI_API_KEY=your_api_key_here
# AI_MODEL=gpt-4o-mini